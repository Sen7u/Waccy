<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Inkboard.App.ViewModels"
        x:Class="Inkboard.App.Views.PopupWindow"
        x:DataType="vm:PopupViewModel"
        Title="Inkboard"
        Width="450" Height="800"
        CanResize="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Topmost="True"
        ShowInTaskbar="False">

  <Border Name="RootChrome"
          CornerRadius="{DynamicResource Radius.Window}"
          Background="{DynamicResource Brush.SurfaceGradient}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1"
          ClipToBounds="True"
          Padding="{DynamicResource Pad.Window}">

    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="{DynamicResource Gap.Md}" Margin="0,0,0,12">
        <!-- 品牌行兼作拖拽区：无系统标题栏时仍可移动窗口 -->
        <DockPanel WindowDecorationProperties.ElementRole="TitleBar">
          <TextBlock Text="Inkboard"
                     FontSize="{DynamicResource Font.Title}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.AccentSoft}"
                     VerticalAlignment="Center" />
          <TextBlock Text="Ctrl+Shift+V · Enter 复制 · Alt+Enter 粘贴"
                     DockPanel.Dock="Right"
                     FontSize="{DynamicResource Font.Meta}"
                     Foreground="{DynamicResource Brush.TextMuted}"
                     VerticalAlignment="Center"
                     Opacity="0.75" />
        </DockPanel>
        <TextBox Name="SearchBox"
                 Classes="ink-search"
                 PlaceholderText="搜索历史…"
                 Text="{Binding SearchText}" />
      </StackPanel>

      <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <Button Classes="ink-ghost"
                Content="清空未置顶"
                Command="{Binding ClearCommand}"
                DockPanel.Dock="Right" />
        <TextBlock Text="{Binding StatusText}"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   FontSize="{DynamicResource Font.Meta}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <Panel IsVisible="{Binding IsEmpty}">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="10">
          <Border Width="56" Height="68"
                  CornerRadius="8"
                  BorderBrush="{DynamicResource Brush.AccentDim}"
                  BorderThickness="2"
                  HorizontalAlignment="Center">
            <Border Width="28" Height="10"
                    CornerRadius="4"
                    Background="{DynamicResource Brush.AccentDim}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,-6,0,0" />
          </Border>
          <TextBlock Text="还没有历史"
                     FontSize="{DynamicResource Font.Body}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="复制点什么，它会出现在这里"
                     FontSize="{DynamicResource Font.Meta}"
                     Foreground="{DynamicResource Brush.TextMuted}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>

      <ListBox Name="HistoryList"
               Classes="ink-list"
               ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedItem}"
               IsVisible="{Binding HasItems}"
               Tapped="OnItemTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryItemRow">
            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
              <Border Grid.Column="0"
                      Width="3"
                      Margin="0,2,8,2"
                      CornerRadius="2"
                      Background="{DynamicResource Brush.Accent}"
                      IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Preview}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.Text}"
                           FontSize="{DynamicResource Font.Body}" />
                <TextBlock Text="{Binding Meta}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           FontSize="{DynamicResource Font.Meta}" />
              </StackPanel>

              <StackPanel Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="2"
                          VerticalAlignment="Center">
                <!-- 置顶始终可点：已置顶用亮色星，未置顶用淡色轮廓感 -->
                <Button Classes="ink-icon"
                        Command="{Binding $parent[Window].((vm:PopupViewModel)DataContext).TogglePinCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="置顶 / 取消置顶">
                  <Path Width="12" Height="12"
                        Stretch="Uniform"
                        Opacity="{Binding PinOpacity}"
                        Fill="{DynamicResource Brush.AccentSoft}"
                        Data="M7,0 L8.5,4.5 L13,5 L9.5,8 L10.5,13 L7,10.5 L3.5,13 L4.5,8 L1,5 L5.5,4.5 Z" />
                </Button>
                <!-- 删除走 code-behind：先做离场动效，再调 VM，避免列表瞬间跳变 -->
                <Button Classes="ink-danger"
                        Content="删除"
                        Click="OnDeleteClick"
                        Tag="{Binding}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</Window>
