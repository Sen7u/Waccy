<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 墨青工具感：色板与尺寸令牌。功能 UI 接入前先定视觉常量。 -->

  <Color x:Key="InkTeal">#0F766E</Color>
  <Color x:Key="InkTealSoft">#14B8A6</Color>
  <Color x:Key="InkSurface">#F4F7F6</Color>
  <Color x:Key="InkSurfaceDark">#0B1211</Color>
  <Color x:Key="InkText">#E8F1EF</Color>
  <Color x:Key="InkTextMuted">#9BB0AC</Color>

  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource InkTeal}" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource InkTealSoft}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource InkSurfaceDark}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource InkText}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource InkTextMuted}" />

  <x:Double x:Key="Radius.Window">12</x:Double>
  <x:Double x:Key="Radius.Row">8</x:Double>
  <x:Double x:Key="Motion.PopupMs">200</x:Double>
  <x:Double x:Key="Motion.SelectionMs">100</x:Double>
</ResourceDictionary>
